# TEMP: builds the wifi-connect binary from THIS repo's source instead of pulling
# balena-os/wifi-connect's prebuilt release, so on-device testing actually exercises
# in-progress fixes. Revert to the release-tarball pull (pointed at the
# animustech/wifi-connect fork) once a fix is confirmed - see feat/reconnect history.
#
# rust:1.76 matches CI's pinned toolchain (.github/workflows/flowzone.yml); there is
# no trixie-tagged rust:1.76 image, so bookworm is the closest available match to the
# trixie runtime below (a glibc built on an older Debian release runs fine on a newer
# one, not vice versa).
FROM rust:1.76-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends libdbus-1-dev pkg-config

WORKDIR /usr/src/app
COPY . .
RUN cargo build --release

FROM debian:trixie

# libdbus-1-3 is needed at runtime because we now dynamically link against it during
# the from-source build above; upstream's prebuilt release binary apparently doesn't
# need it (likely statically linked).
RUN apt-get update && apt-get install -y --no-install-recommends dnsmasq wireless-tools iproute2 curl ca-certificates libdbus-1-3

# use latest version. If specific version is required, it should be provided as vX.Y.Z, e.g v4.11.37
ARG VERSION="latest"

# create /usr/src/app/ui directory where we will extract pre-built UI
WORKDIR /usr/src/app/ui

WORKDIR /usr/src/app

# The UI is static assets, unrelated to the Rust source above - still pulled from
# upstream's release.
RUN \
    export BASE_URL="https://github.com/balena-os/wifi-connect/releases" &&\
    if [ ${VERSION} = "latest" ]; then \
        export URL_PARTIAL="latest/download" ; \
    else \
        export URL_PARTIAL="download/${VERSION}" ; \
    fi; \
    curl -Ls "$BASE_URL/$URL_PARTIAL/wifi-connect-ui.tar.gz" \
    | tar -xvz -C  /usr/src/app/ui

COPY --from=builder /usr/src/app/target/release/wifi-connect /usr/src/app/wifi-connect
COPY scripts/start.sh .

CMD ["bash", "start.sh"]
